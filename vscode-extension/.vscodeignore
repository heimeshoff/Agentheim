# Keep the packaged .vsix lean: ship only the runtime (extension.js + src/),
# the manifest, and the README. Tests and tooling stay out of the bundle.
test/**
**/*.test.mjs
.vscode/**
.gitignore
node_modules/**
# A previously committed .vsix must never nest inside the next packaged one
# (infrastructure-j3rsn: the .vsix is now itself a committed release artifact).
*.vsix
# The live-tree lint is release tooling, not extension runtime.
vsix-lint.mjs
