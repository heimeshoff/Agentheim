diff --git a/src/widget.js b/src/widget.js
new file mode 100644
--- /dev/null
+++ b/src/widget.js
@@ -0,0 +1,18 @@
+// Introduces a new, undocumented domain term: "Lacquering" (and the
+// "Strategy" pattern name) — neither appears in the BC README's
+// Ubiquitous language section.
+class WidgetLacqueringStrategy {
+  apply(widget, color) {
+    widget.color = color;
+  }
+}
+
+class Widget {
+  constructor() {
+    this.color = null;
+    this.lacqueringStrategy = new WidgetLacqueringStrategy();
+  }
+
+  paint(color) {
+    this.lacqueringStrategy.apply(this, color);
+  }
+}
+
+module.exports = { Widget, WidgetLacqueringStrategy };
diff --git a/test/widget.test.js b/test/widget.test.js
new file mode 100644
--- /dev/null
+++ b/test/widget.test.js
@@ -0,0 +1,8 @@
+const { test } = require('node:test');
+const assert = require('node:assert');
+const { Widget } = require('../src/widget.js');
+
+test('painting a widget sets its color', () => {
+  const w = new Widget();
+  w.paint('red');
+  assert.strictEqual(w.color, 'red');
+});
